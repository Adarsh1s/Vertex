Project PortfolioRecommendationSystem {
  database_type: 'PostgreSQL'
  Note: 'Portfolio Recommendation System - DBMS Case Study'
}

Table neon_auth.users_sync {
  id varchar [primary key, note: 'UUID managed by Neon Auth']
  email varchar
  name varchar
  created_at timestamp
}

Table risk_profiles {
  risk_profile_id int [primary key, increment]
  profile_name varchar
  min_score int
  max_score int
  description text
}

Table user_profiles {
  profile_id int [primary key, increment]
  user_id varchar [unique, ref: - neon_auth.users_sync.id]
  monthly_income numeric
  monthly_expenses numeric
  investment_amount numeric
  investment_horizon_years int
  investment_goal varchar
  risk_score int
  risk_profile_id int [ref: > risk_profiles.risk_profile_id]
  updated_at timestamp
}

Table asset_classes {
  asset_class_id int [primary key, increment]
  name varchar
  description text
}

Table portfolio_models {
  model_id int [primary key, increment]
  model_name varchar
  risk_profile_id int [ref: > risk_profiles.risk_profile_id]
  description text
}

Table portfolio_allocations {
  allocation_id int [primary key, increment]
  model_id int [ref: > portfolio_models.model_id]
  asset_class_id int [ref: > asset_classes.asset_class_id]
  allocation_percentage numeric
}

Table sub_allocation_templates {
  template_id int [primary key, increment]
  model_id int [ref: > portfolio_models.model_id]
  asset_class_id int [ref: > asset_classes.asset_class_id]
}

Table instruments {
  instrument_id int [primary key, increment]
  name varchar
  ticker varchar
  asset_class_id int [ref: > asset_classes.asset_class_id]
  instrument_type varchar
  fund_house varchar
  is_active boolean
}

Table instrument_allocations {
  inst_allocation_id int [primary key, increment]
  template_id int [ref: > sub_allocation_templates.template_id]
  instrument_id int [ref: > instruments.instrument_id]
  allocation_percentage numeric
}

Table user_portfolios {
  portfolio_id int [primary key, increment]
  user_id varchar [ref: > neon_auth.users_sync.id]
  model_id int [ref: > portfolio_models.model_id]
  total_investment numeric
  is_active boolean
  version int
  generated_at timestamp
}

Table user_portfolio_positions {
  position_id int [primary key, increment]
  portfolio_id int [ref: > user_portfolios.portfolio_id]
  instrument_id int [ref: > instruments.instrument_id]
  allocation_percentage numeric
  allocated_amount numeric
}

Table instrument_returns {
  return_id int [primary key, increment]
  instrument_id int [ref: > instruments.instrument_id]
  period varchar
  return_percentage numeric
  recorded_at date
}

Table audit_log {
  log_id int [primary key, increment]
  user_id varchar [ref: > neon_auth.users_sync.id]
  action varchar
  metadata jsonb
  created_at timestamp
}
