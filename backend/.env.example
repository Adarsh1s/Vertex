# Backend Environment Variables
# Copy this file to .env and fill in your real Neon credentials

# ─── Neon PostgreSQL (use the pooled connection string) ─────────────────────
# Found in: Neon Dashboard → Your Project → Connection Details → Pooled connection
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# ─── Neon Auth JWKS endpoint ────────────────────────────────────────────────
# Found in: Neon Dashboard → Auth → API → JWKS URL
NEON_AUTH_JWKS_URL=https://YOUR-PROJECT.neon.tech/.well-known/jwks.json

# ─── FastAPI settings ────────────────────────────────────────────────────────
APP_ENV=development

# For local dev: http://localhost:8501
# For Docker:    http://frontend:8501
ALLOWED_ORIGINS=["http://localhost:8501","http://frontend:8501"]
