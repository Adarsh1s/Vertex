# Backend Environment Variables
# Copy this file to .env and fill in your real Neon credentials

# ─── Neon PostgreSQL Cloud Database ──────────────────────────────────────────
# Found in: Neon Dashboard → Project Details → Connection Details
# Use pooled connection string (with ?sslmode=require)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/FinPulse?sslmode=require

# ─── Native Database Auth (PBKDF2 + JWT) ───────────────────────────────────────
LOCAL_AUTH_SECRET=your-secure-random-secret-key-change-in-production
LOCAL_AUTH_TOKEN_HOURS=8

# ─── FastAPI settings ────────────────────────────────────────────────────────
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:8501","http://frontend:8501"]
